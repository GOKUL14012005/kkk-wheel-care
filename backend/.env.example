# =============================================================
# KKK Wheel Care - Backend Environment Configuration Template
# Copy this file to .env and configure your local settings.
# DO NOT commit the .env file with real credentials to Git.
# =============================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=kkk_wheel_care
DB_CONNECTION_LIMIT=10

# Security (JWT / Secret keys for academic evaluation)
JWT_SECRET=academic_kkk_wheel_care_super_secret_jwt_key_2026
