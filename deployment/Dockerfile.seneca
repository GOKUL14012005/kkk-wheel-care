# ====================================================================
# Dockerfile for KKK Wheel Care Seneca Tyre Recommendation Microservice
# ====================================================================

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5001

# Install production dependencies
COPY microservices/tyre-recommendation/package.json microservices/tyre-recommendation/package-lock.json ./
RUN npm ci --only=production --prefer-offline --no-audit

# Copy microservice source
COPY microservices/tyre-recommendation/ .

USER node

EXPOSE 5001

# Health check against Seneca microservice health endpoint
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:5001/health || exit 1

CMD ["node", "service.js"]
