# ====================================================================
# Docker Compose Environment Template (Production Placeholders)
# Copy this file to deployment/.env before running docker-compose up
# ====================================================================

# Database Credentials (used inside the container network)
DB_ROOT_PASSWORD=replace_with_strong_production_root_password
DB_NAME=kkk_wheel_care
DB_USER=kkk_app_user
DB_PASSWORD=replace_with_strong_application_user_password

# Security Tokens
JWT_SECRET=replace_with_long_cryptographically_secure_random_string_2026
